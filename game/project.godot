; Unturned → Godot port — engine skeleton (Phase 0b Godot half). Generated by catboy.
config_version=5

[application]
config/name="Unturned Godot"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
run/main_scene="res://Main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[audio]

; Required for AudioStreamMicrophone to receive anything: with this false the capture effect still runs and
; still delivers frames, they are just always silence. NOTE the honest limit -- this box has no microphone
; and runs the Dummy driver, where capture yields exactly-silent frames WITH OR WITHOUT this line, so the
; setting cannot be proven here. It is proven on a desktop with real hardware (BugReporter tags the report
; audio_status=nomic when the amplitude says nothing was heard, so a broken setting reports itself rather
; than shipping a silent report labelled ok).
driver/enable_input=true

[display]
window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; vsync OFF globally (strawberry 2026-08-10). With a pacer on, frame time is pinned to the refresh
; interval and shows headroom as zero -- you cannot profile CPU against a number the display is choosing.
window/vsync/vsync_mode=0

[dotnet]
project/assembly_name="UnturnedGodot"

[physics]
3d/physics_engine="JoltPhysics3D"
common/physics_ticks_per_second=50
common/physics_interpolation=true

[rendering]

; Multithreaded renderer ON by default (strawberry 2026-09-03 "flip multithreaded renderer on by default"): +26% on the
; CPU-bound PEI idle scene on the 4080S. The in-game Graphics row still toggles it (override.cfg writes =1 for Single).
driver/threads/thread_model=2
