<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>UnturnedBevy.Bridge</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../core/UnturnedNet/UnturnedNet.csproj" />
    <ProjectReference Include="../../core/BugReportCore/BugReportCore.csproj" />
    <Compile Include="../../game/MeleeDef.cs" Link="Source/MeleeDef.cs" />
    <Compile Include="../../game/GunDef.cs" Link="Source/GunDef.cs" />
    <Compile Include="../../game/inventory/ItemCatalog.cs" Link="Source/ItemCatalog.cs" />
    <Compile Include="../../game/inventory/BlueprintRegistry.cs" Link="Source/BlueprintRegistry.cs" />
    <Compile Include="../../game/DeployableNetSchema.cs" Link="Source/DeployableNetSchema.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/DeployableData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/CatalogEnums.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/FluidArtData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/RetailLootData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/WorldDefaults.g.cs" />
    <Compile Include="../../game/LevelSpawns.cs" Link="Source/LevelSpawns.cs" />
    <Compile Include="../../game/inventory/FarmDef.cs" Link="Source/FarmDef.cs" />
    <Compile Include="../../game/NpcCatalog.cs" Link="Source/NpcCatalog.cs" />
    <Compile Include="../../game/GasStationServer.cs" Link="Source/GasStationServer.cs" />
    <Compile Include="../../game/StationFuel.cs" Link="Source/StationFuel.cs" />
    <Compile Include="../../game/inventory/ContainerSchema.cs" Link="Source/ContainerSchema.cs" />
    <Compile Include="../../game/inventory/LootTables.cs" Link="Source/LootTables.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/CropData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/FluidTankData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/FoodSpoilData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/ShelfData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/ContainerKinds.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/ContainerNetSync.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/HolidayData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/DestructibleDrops.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/RubbleData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/DeadzoneData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/ResourceData.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/ResourceRules.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/WeaponClips.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Data/WeaponInventory.g.cs" />
  </ItemGroup>
  <Target Name="ExtractOriginalData" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract_data.py&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Data&quot;" />
  </Target>
</Project>
